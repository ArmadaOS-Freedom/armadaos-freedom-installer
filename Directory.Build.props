<Project>

  <PropertyGroup>
    <!-- Settings shared by every project in this repository. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- 安装助手自身版本号（非 ArmadaOS 系统版本）。AssemblyVersion/FileVersion 固定四段；
         IncludeSourceRevisionInInformationalVersion=false 使 InformationalVersion 保持 0.8.0，不追加 git 提交号。 -->
    <Version>0.8.0</Version>
    <InformationalVersion>0.8.0</InformationalVersion>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Build output stays next to each project so artefacts are never confused with
         authoritative source files. -->
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Enable strict end-of-input validation in the application and test hosts from startup. -->
    <RuntimeHostConfigurationOption Include="System.IO.Compression.UseStrictValidation" Value="true" />
  </ItemGroup>

  <!-- Locally downloaded, hash-verified public build inputs. Projects consume these
       values in ItemGroups during evaluation, so the import must run here. -->
  <Import Project="$(BundledBuildInputsProps)"
          Condition="'$(BundledBuildInputsProps)' != '' and Exists('$(BundledBuildInputsProps)')" />

  <Target Name="FailOnMissingBundledBuildInputsProps"
          BeforeTargets="PrepareForBuild"
          Condition="'$(BundledBuildInputsProps)' != '' and !Exists('$(BundledBuildInputsProps)')">
    <Error Text="BundledBuildInputsProps was specified as '$(BundledBuildInputsProps)' but the file does not exist." />
  </Target>

</Project>
