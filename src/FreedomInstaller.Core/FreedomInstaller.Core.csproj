<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FreedomInstaller.Core</RootNamespace>
    <AssemblyName>FreedomInstaller.Core</AssemblyName>
  </PropertyGroup>

  <!-- Build-time source for the six EDL tool pins. When BundledToolPinsSource is non-empty it must
       name a generated C# file that declares the same namespace/class/const fields as the default
       CompiledToolPins.cs; the default file is then excluded and the generated file compiled instead.
       The property is loaded by the existing props import before this project is evaluated, so no new
       import or global target is added here. An empty property keeps the frozen defaults. -->
  <ItemGroup Condition="'$(BundledToolPinsSource)' != ''">
    <Compile Remove="CompiledToolPins.cs" />
    <Compile Include="$(BundledToolPinsSource)" Link="CompiledToolPins.cs" />
  </ItemGroup>

  <Target Name="RequireBundledToolPinsSource" BeforeTargets="PrepareForBuild"
          Condition="'$(BundledToolPinsSource)' != '' and !Exists('$(BundledToolPinsSource)')">
    <Error Text="BundledToolPinsSource was set explicitly but the file does not exist: $(BundledToolPinsSource)" />
  </Target>

  <!-- Requested archive readers: 7z, RAR, TAR, tar.gz, tar.xz, tar.zst and tar.bz2.
       SharpCompress is a single fully managed, MIT-licensed dependency (net10 supported); no external
       archiver executable and no native helper is installed or invoked at build or run time. ZIP/ZIP64
       keeps using System.IO.Compression, so the fast path never goes through this library. -->
  <!-- Fixed system release trust anchor for signed install/offline-upgrade documents. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\armadaos-freedom.pub"
                      LogicalName="FreedomInstaller.UpdateTrust.PublicKey.pem"
                      WithCulture="false" />
    <!-- Runs on the tablet before the offline updater starts. Standalone by
         design: it must repair a legacy ARMADA_BACKUP descriptor without
         importing the installed (and possibly incompatible) update runtime. -->
    <EmbeddedResource Include="Resources\offline-recovery-descriptor-migration.py"
                      LogicalName="FreedomInstaller.OfflineRecoveryDescriptor.Script.py"
                      WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.6" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <!-- Managed SSH transport for password authentication. Pinned; no native helper. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!-- The password transport's internal transport seam is exercised by the focused
       core tests with an in-memory fake; no production type becomes public for it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FreedomInstaller.Core.Tests" />
  </ItemGroup>

  <!-- Fixed AOSP AVB public test RSA4096 signing material, supplied by the build
       from outside the source tree. This is a mandatory input: there is no
       default key, generated key, or unsigned fallback. -->
  <ItemGroup Condition="'$(BundledAvbSigningKey)' != '' and Exists('$(BundledAvbSigningKey)')">
    <EmbeddedResource Include="$(BundledAvbSigningKey)"
                      LogicalName="FreedomInstaller.AvbTestKey.pem"
                      Link="AvbTestKey.pem"
                      WithCulture="false" />
  </ItemGroup>

  <!-- Pinned standard GBL runtime EFI assets (PRC/ROW), supplied by the build from outside the
       source tree and embedded under fixed logical names only when an existing file is given.
       They are optional here: there is no default path, no download or generation, and a plain
       Core build never fails because they are absent. The single-file publish validates them. -->
  <ItemGroup Condition="'$(BundledGblPrcEfi)' != '' and Exists('$(BundledGblPrcEfi)')">
    <EmbeddedResource Include="$(BundledGblPrcEfi)"
                      LogicalName="FreedomInstaller.GblRuntime.Prc.efi"
                      Link="generic_superfastboot_prc.efi"
                      WithCulture="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(BundledGblRowEfi)' != '' and Exists('$(BundledGblRowEfi)')">
    <EmbeddedResource Include="$(BundledGblRowEfi)"
                      LogicalName="FreedomInstaller.GblRuntime.Row.efi"
                      Link="generic_superfastboot_row.efi"
                      WithCulture="false" />
  </ItemGroup>

  <!-- TB322FC compatibility loader from the reviewed 188 firmware package. This optional
       external build input is embedded byte-for-byte under a fixed logical name only for test
       builds that select the 188-ABL route. It is never downloaded, generated or committed. -->
  <ItemGroup Condition="'$(BundledTb322fcAbl188)' != '' and Exists('$(BundledTb322fcAbl188)')">
    <EmbeddedResource Include="$(BundledTb322fcAbl188)"
                      LogicalName="FreedomInstaller.Tb322fc.Abl188.img"
                      Link="tb322fc-abl-188.img"
                      WithCulture="false" />
  </ItemGroup>

  <!-- TB323FU GBL-capable compatibility loader from the reviewed 2.0.12.088 firmware package.
       Embedded byte-for-byte under a fixed logical name when supplied by the build; never
       downloaded or generated at run time. -->
  <ItemGroup Condition="'$(BundledTb323fuAbl088)' != '' and Exists('$(BundledTb323fuAbl088)')">
    <EmbeddedResource Include="$(BundledTb323fuAbl088)"
                      LogicalName="FreedomInstaller.Tb323fu.Abl088.img"
                      Link="tb323fu-abl-088.img"
                      WithCulture="false" />
  </ItemGroup>

  <!-- TB710FU AOSP-capable loader: the CN ZUI 17.0.04.279 abl as one whole 1 MiB partition (the bytes the
       ZUXOS 1.5.04.495 no-unlock supplement writes). Embedded byte-for-byte under a fixed logical name only
       when BundledTb710fuAospAbl is passed; it replaces a locked stock 495 ABL that verifies with Lenovo's key. -->
  <ItemGroup Condition="'$(BundledTb710fuAospAbl)' != '' and Exists('$(BundledTb710fuAospAbl)')">
    <EmbeddedResource Include="$(BundledTb710fuAospAbl)"
                      LogicalName="FreedomInstaller.Tb710fu.AospAbl.img"
                      Link="tb710fu-abl-279.img"
                      WithCulture="false" />
  </ItemGroup>

  <!-- Upstream GBL attribution and the verbatim GNU GPL version 3 text shipped with those assets. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\GblRuntime-NOTICE.txt"
                      LogicalName="FreedomInstaller.Licenses.Gbl.NOTICE.txt"
                      WithCulture="false" />
    <EmbeddedResource Include="..\..\docs\GblRuntime-LICENSE.txt"
                      LogicalName="FreedomInstaller.Licenses.Gbl.GPL3.txt"
                      WithCulture="false" />
  </ItemGroup>

  <!-- Fixed TF-card RAM maintenance helper script; the TF bootstrap embeds it verbatim
       into the support archive it uploads to the device. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\maintenance\armada_tf.py"
                      LogicalName="FreedomInstaller.TfMaintenance.Helper.py"
                      WithCulture="false" />
  </ItemGroup>

  <Target Name="RequireBundledAvbSigningKey" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BundledAvbSigningKey)' == ''"
           Text="BundledAvbSigningKey is required. Pass -p:BundledAvbSigningKey=&lt;path-to-avb-test-key.pem&gt; with the AOSP AVB public test RSA4096 PEM located outside the source tree." />
    <Error Condition="'$(BundledAvbSigningKey)' != '' and !Exists('$(BundledAvbSigningKey)')"
           Text="BundledAvbSigningKey does not exist: $(BundledAvbSigningKey)" />
  </Target>

  <Target Name="RequireBundledTb322fcAbl188" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BundledTb322fcAbl188)' != '' and !Exists('$(BundledTb322fcAbl188)')"
           Text="BundledTb322fcAbl188 does not exist: $(BundledTb322fcAbl188)" />
  </Target>

  <Target Name="RequireBundledTb323fuAbl088" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BundledTb323fuAbl088)' != '' and !Exists('$(BundledTb323fuAbl088)')"
           Text="BundledTb323fuAbl088 does not exist: $(BundledTb323fuAbl088)" />
  </Target>

  <Target Name="RequireBundledTb710fuAospAbl" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BundledTb710fuAospAbl)' != '' and !Exists('$(BundledTb710fuAospAbl)')"
           Text="BundledTb710fuAospAbl does not exist: $(BundledTb710fuAospAbl)" />
  </Target>

</Project>
