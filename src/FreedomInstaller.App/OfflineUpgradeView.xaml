<UserControl x:Class="FreedomInstaller.App.OfflineUpgradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CanvasBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Button x:Name="BackButton" Style="{DynamicResource GhostButton}" Content="{DynamicResource Static.OfflineUpdate.Back}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <TextBlock Style="{DynamicResource H1Text}" Text="{DynamicResource Static.OfflineUpdate.Title}"/>
                <TextBlock Style="{DynamicResource BodyInkText}" Text="{DynamicResource Static.OfflineUpdate.Desc}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                <Border Style="{DynamicResource CardBorder}" Background="{DynamicResource SurfaceBrush}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource H2Text}" Text="{DynamicResource Static.OfflineUpdate.SectionConnection}"/>
                        <TextBlock Style="{DynamicResource CaptionText}" Text="{DynamicResource Static.OfflineUpdate.ConnectionHelper}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="UsbConnectButton" Style="{DynamicResource PrimaryButton}" Content="{DynamicResource Static.OfflineUpdate.UsbConnect}" Margin="0,0,8,0"/>
                            <Button x:Name="DisconnectButton" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.Disconnect}" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel x:Name="PairingPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock Style="{DynamicResource H2Text}" Text="{DynamicResource Static.OfflineUpdate.PairingHeading}" Margin="0,0,0,4"/>
                            <TextBlock Style="{DynamicResource CaptionText}" Text="{DynamicResource Static.OfflineUpdate.PairingInstructions}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PairingHostText" Style="{DynamicResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.PairingCommand}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PairingCommandBox" Style="{DynamicResource InputTextBox}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="55" MaxHeight="95" VerticalScrollBarVisibility="Auto"/>
                            <Button x:Name="CopyPairingCommandButton" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.CopyPairingCommand}" HorizontalAlignment="Left" Margin="0,8,0,10"/>
                            <TextBlock Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.PairingReceipt}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PairingReceiptBox" Style="{DynamicResource InputTextBox}" MaxLength="4096" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65" MaxHeight="105" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                            <Button x:Name="ConfirmPairingButton" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.ConfirmPairing}" HorizontalAlignment="Left" IsEnabled="False"/>
                        </StackPanel>
                        <Expander x:Name="ConnectionDetails" Style="{DynamicResource SectionExpander}" IsExpanded="False" Header="{DynamicResource Static.OfflineUpdate.ConnectionDetails}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource CaptionText}" Text="{DynamicResource Static.OfflineUpdate.ManualConnectionHelp}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.Host}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox x:Name="HostBox" Grid.Column="1" Style="{DynamicResource InputTextBox}" Margin="0,0,14,8"/>
                                    <TextBlock Grid.Column="2" Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.Port}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox x:Name="PortBox" Grid.Column="3" Style="{DynamicResource InputTextBox}" Text="22" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.User}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="UserBox" Grid.Row="1" Grid.Column="1" Style="{DynamicResource InputTextBox}"/>
                                </Grid>
                                <TextBlock Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.KeyPath}" Margin="0,10,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="KeyPathBox" Style="{DynamicResource InputTextBox}" Margin="0,0,8,0"/>
                                    <Button x:Name="BrowseKeyButton" Grid.Column="1" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.BrowseKey}"/>
                                </Grid>
                                <TextBlock Style="{DynamicResource CaptionText}" Text="{DynamicResource Static.OfflineUpdate.KeyPrivacy}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <TextBlock Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.KnownHosts}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="KnownHostsBox" Style="{DynamicResource InputTextBox}" Margin="0,0,8,0"/>
                                    <Button x:Name="BrowseHostsButton" Grid.Column="1" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.BrowseHosts}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="ConnectButton" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.Connect}" Margin="0,0,8,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="DeviceText" Style="{DynamicResource FieldValueText}" Text="{DynamicResource Static.OfflineUpdate.DevicePending}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Background="{DynamicResource SurfaceBrush}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource H2Text}" Text="{DynamicResource Static.OfflineUpdate.SectionPackage}"/>
                        <TextBlock Style="{DynamicResource CaptionText}" Text="{DynamicResource Static.OfflineUpdate.PackageHelp}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <TextBlock Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.PackagePath}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="PackagePathBox" Style="{DynamicResource InputTextBox}" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button x:Name="BrowsePackageButton" Grid.Column="1" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.BrowsePackage}"/>
                        </Grid>
                        <Button x:Name="ValidatePackageButton" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.ValidatePackage}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock x:Name="PackageText" Style="{DynamicResource FieldValueText}" Text="{DynamicResource Static.OfflineUpdate.PackagePending}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.Session}" Margin="0,10,0,4"/>
                        <ComboBox x:Name="SessionCombo" Style="{DynamicResource ThemeComboBox}" IsEnabled="False"/>
                        <TextBlock Style="{DynamicResource CaptionText}" Text="{DynamicResource Static.OfflineUpdate.SessionHelper}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RefreshButton" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.Refresh}" Margin="0,0,8,0"/>
                            <Button x:Name="PrepareButton" Style="{DynamicResource PrimaryButton}" Content="{DynamicResource Static.OfflineUpdate.Prepare}" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Background="{DynamicResource SurfaceBrush}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource H2Text}" Text="{DynamicResource Static.OfflineUpdate.SectionConfirm}"/>
                        <TextBlock Style="{DynamicResource CaptionText}" Text="{DynamicResource Static.OfflineUpdate.PrepareHelp}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <CheckBox x:Name="ConfirmCheck" Style="{DynamicResource RiskCheckBox}" Content="{DynamicResource Static.OfflineUpdate.Confirm}" IsEnabled="False"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ExecuteButton" Style="{DynamicResource PrimaryButton}" Content="{DynamicResource Static.OfflineUpdate.Execute}" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button x:Name="StopWaitingButton" Style="{DynamicResource SecondaryButton}" Content="{DynamicResource Static.OfflineUpdate.StopWaiting}" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Background="{DynamicResource SurfaceAltBrush}" Padding="14">
                    <StackPanel>
                        <TextBlock x:Name="StateText" Style="{DynamicResource BodyInkText}" Text="{DynamicResource Static.OfflineUpdate.StatePending}" TextWrapping="Wrap"/>
                        <Button x:Name="RestartToVerifyButton" Style="{DynamicResource PrimaryButton}" Content="{DynamicResource Static.OfflineUpdate.RestartToVerify}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <ProgressBar x:Name="TransferProgress" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,4"/>
                        <TextBlock x:Name="ProgressText" Style="{DynamicResource CaptionText}" Text="0%"/>
                        <TextBlock Style="{DynamicResource FieldLabelText}" Text="{DynamicResource Static.OfflineUpdate.RecoveryPath}" Margin="0,8,0,2"/>
                        <TextBlock x:Name="RecoveryPathText" Style="{DynamicResource FieldValueText}" Text="{DynamicResource Static.OfflineUpdate.RecoveryPending}" TextWrapping="Wrap"/>
                        <Expander x:Name="DetailsExpander" Style="{DynamicResource SectionExpander}" IsExpanded="False" Header="{DynamicResource Static.OfflineUpdate.Details}" Margin="0,8,0,0">
                            <TextBlock x:Name="DetailsText" Style="{DynamicResource BodyText}" Text="{DynamicResource Static.OfflineUpdate.DetailsPending}" TextWrapping="Wrap"/>
                        </Expander>
                        <Expander x:Name="LogExpander" Style="{DynamicResource SectionExpander}" IsExpanded="False" Header="{DynamicResource Static.OfflineUpdate.Log}" Margin="0,6,0,0">
                            <TextBox x:Name="LogText" Style="{DynamicResource InputTextBox}" IsReadOnly="True" MaxHeight="200" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
