<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FreedomInstaller.Core.Tests</RootNamespace>
    <AssemblyName>FreedomInstaller.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Same reason: failure diagnostics and work-log persistence are plain BCL code, so the
         regression can assert them without launching the WPF window. -->
    <Compile Include="..\..\src\FreedomInstaller.App\InstallerLog.cs" Link="InstallerLog.cs" />
    <!-- AVB02 synthetic ABL container: a tiny generated ELF/FV/LZMA fixture, never device firmware.
         Generated by validation/generate_direct_aosp_abl.py before the test run. -->
    <None Update="Fixtures\direct-aosp-abl\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FreedomInstaller.Core\FreedomInstaller.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(BundledToolPinsSource)' != ''">
    <!-- When the build selects an external CompiledToolPins.cs, link that exact file into the test
         assembly so the internal-type reflection in CompiledToolPinsTests observes the same pins as Core. -->
    <Compile Include="$(BundledToolPinsSource)" Link="CompiledToolPins.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(BundledToolPinsSource)' == ''">
    <!-- Otherwise link the default compiled source (Core's internal type is not visible across assemblies,
         so the tests need their own identical copy for reflection; no InternalsVisibleTo, no public type). -->
    <Compile Include="..\..\src\FreedomInstaller.Core\CompiledToolPins.cs" Link="CompiledToolPins.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the real bundled-tools helper source so the extraction logic is tested without
         referencing the WPF App project (keeps these tests runnable on Linux). -->
    <Compile Include="..\..\src\FreedomInstaller.App\BundledTools.cs" Link="BundledTools.cs" />
    <!-- Same reason: the bundled Qualcomm driver helper and the driver installer's pure
         classification helpers are linked in so their behaviour can be tested without the WPF
         App project (which also owns the embedded driver archive resource). -->
    <Compile Include="..\..\src\FreedomInstaller.App\BundledQualcommDriver.cs" Link="BundledQualcommDriver.cs" />
    <Compile Include="..\..\src\FreedomInstaller.App\BundledAndroidDriver.cs" Link="BundledAndroidDriver.cs" />
    <Compile Include="..\..\src\FreedomInstaller.App\WindowsDriverInstaller.cs" Link="WindowsDriverInstaller.cs" />
    <!-- Same reason: the localization text lookup and the preference file are plain BCL code,
         so they are compiled into this assembly instead of referencing the WPF App project. -->
    <Compile Include="..\..\src\FreedomInstaller.App\UiText.cs" Link="UiText.cs" />
    <Compile Include="..\..\src\FreedomInstaller.App\UserPreferences.cs" Link="UserPreferences.cs" />
    <!-- Same reason: the board-first recovery selection source is plain C# (no WPF types);
         linking it lets the regression exercise the real production method headlessly. -->
    <Compile Include="..\..\src\FreedomInstaller.App\MainWindow.RecoverySource.cs" Link="MainWindow.RecoverySource.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the exact catalogs the App ships, under the same logical names, so the tests read
         the real strings instead of a copy that can drift. WithCulture="false" keeps the language
         suffix from turning any of these into a satellite assembly resource: the tests, like the
         App, must find all four catalogs in the executing assembly itself. -->
    <EmbeddedResource Include="..\..\src\FreedomInstaller.App\Resources\Static.zh-CN.json"
                      LogicalName="FreedomInstaller.Strings.Static.zh-CN.json"
                      Link="Static.zh-CN.json"
                      WithCulture="false" />
    <EmbeddedResource Include="..\..\src\FreedomInstaller.App\Resources\Static.en.json"
                      LogicalName="FreedomInstaller.Strings.Static.en.json"
                      Link="Static.en.json"
                      WithCulture="false" />
    <EmbeddedResource Include="..\..\src\FreedomInstaller.App\Resources\Dynamic.zh-CN.json"
                      LogicalName="FreedomInstaller.Strings.Dynamic.zh-CN.json"
                      Link="Dynamic.zh-CN.json"
                      WithCulture="false" />
    <EmbeddedResource Include="..\..\src\FreedomInstaller.App\Resources\Dynamic.en.json"
                      LogicalName="FreedomInstaller.Strings.Dynamic.en.json"
                      Link="Dynamic.en.json"
                      WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real multi-format archives (and their expected manifests) are shipped next to the test
         assembly so the import tests read them from AppContext.BaseDirectory. Update, not Include,
         because the SDK's default None glob already claims these files. -->
    <None Update="Fixtures\Import\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
